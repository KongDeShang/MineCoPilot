node_modules/
dist/
release/
# release-online/ 是「在线包」的打包输出（含 180MB 的 setup.exe），与 release/ 同类。
# 原来只忽略了 release/，这个目录一直是未跟踪状态 —— 离一次 git add -A 只差一步，
# 而 180MB 的二进制一旦入库就再也拿不出来了（历史里删不掉，只能重写）。
release-online/
# 临时/中间文件（.tmp-*/ 只忽略目录，漏掉了同前缀的**文件**——
# 曾经因为这条漏网，一次 git add -A 把 .tmp-commit-msg.txt 提交了进去）
.tmp-*
.DS_Store
*.log

# 临时/中间文件
*.tmp
*.bak
.vite/

# 大体积本地资源（不入库，见 README 的获取说明）
resources/models/
资料/
释放演示数据/

# 说明书的**派生物**。docx 与 pdf 都由同一份 HTML 生成：
#   python docs/tools/html2docx.py                        # 产品说明.html -> 产品说明.docx
#   chrome --headless=new --no-pdf-header-footer \
#     --print-to-pdf=docs/产品说明.pdf docs/产品说明.html     # HTML -> pdf
# 源头（docs/产品说明.html）与素材（docs/说明书配图/）入库，派生物不入库 —— 与 release/ 同一条口径。
# 2026-09-28：原来还有一份《作品说明书》，与产品说明约四成内容重复（同一批文字与同一批截图），
# 已合并进产品说明这一份，四件套一并删除。
docs/产品说明.docx
docs/产品说明.pdf

# 开发期的临时工作区（探针脚本、实跑日志、截图、变异测试备份）。
# 一直靠"没人 git add -A"保持未跟踪，和上面 release-online/ 是同一类隐患：
# 一旦被扫进去，日志与截图进了历史就再也拿不出来。2026-09-28 收口时补上这一条，
# 把"靠运气"换成"靠规则"。
.workbuddy/
