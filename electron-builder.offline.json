{
  "appId": "com.kuangshan.zhigong",
  "productName": "矿山智工",
  "copyright": "Copyright © 2026 石家庄铁道大学 孔德尚 · 保留所有权利",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "src/main/**/*",
    "src/preload/**/*",
    "dist/**/*",
    "package.json",
    "!node_modules/@node-llama-cpp/win-arm64/**",
    "!node_modules/@node-llama-cpp/win-x64-cuda/**",
    "!node_modules/@node-llama-cpp/win-x64-cuda-ext/**"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/node-llama-cpp/**/*",
    "node_modules/@node-llama-cpp/**/*",
    "node_modules/**/*.node",
    "**/*.wasm"
  ],
  "extraResources": [
    {
      "from": "resources/models",
      "to": "models"
    },
    {
      "from": "src/renderer/public/manuals",
      "to": "manuals"
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "矿山智工"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "category": "public.app-category.business"
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "Office"
  }
}
